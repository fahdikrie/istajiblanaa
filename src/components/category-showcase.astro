---
import { cn } from "@/lib/utils";

import {
  featuredCategoryCards,
  getCategoryImagePath,
} from "@/data/category-cards";

import { Card } from "./ui/card";

const cardClassname =
  "group relative h-[130px] overflow-hidden rounded-xl border border-gray-100 p-3 shadow-none cursor-pointer flex flex-col justify-end transition-transform duration-200 hover:-translate-y-0.5";

const featuredCards = featuredCategoryCards.slice(0, 6);
---

<div class="grid grid-cols-2 md:grid-cols-3 gap-2">
  {
    featuredCards.map((card) => (
      <a href={card.href}>
        <Card
          className={cn(cardClassname)}
          style={{
            backgroundImage: `linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.68)), url(${getCategoryImagePath(card.title, card.cue)})`,
            backgroundSize: "cover",
            backgroundPosition: "center",
          }}
        >
          <h3 class="font-bold text-sm text-white drop-shadow">{card.title}</h3>
          <p class="font-light text-xs text-white/85 drop-shadow-sm line-clamp-3">
            {card.description}
          </p>
        </Card>
      </a>
    ))
  }
  <a href="/categories">
    <Card className={cn(cardClassname, "md:bg-zinc-100 md:border-zinc-200")}>
      <h3 class="font-bold md:text-gray-800">Semua Kategori</h3>
      <p
        class="font-light text-xs text-gray-500 dark:text-zinc-50 md:dark:text-gray-600"
      >
        Lihat semua kategori dan kelompok-kelompok doa.
      </p>
    </Card>
  </a>
</div>
