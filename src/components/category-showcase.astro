---
import { cn } from "@/lib/utils";

const baseCard =
  "relative overflow-hidden h-[150px] rounded-xl border p-4 flex flex-col justify-end gap-1 cursor-pointer transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md w-full";
---

<div class="grid grid-cols-2 md:grid-cols-3 gap-2">
  <!-- The Essentials — desktop only -->
  <a href="/" class="hidden md:block group">
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-emerald-50 to-green-100 border-green-200 dark:from-emerald-950 dark:to-green-900 dark:border-green-800",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🎒</span
      >
      <h3 class="font-bold text-sm text-green-900 dark:text-green-100">
        The Essentials
      </h3>
      <p class="text-xs text-green-700/70 dark:text-green-300/70 leading-snug">
        Kumpulan doa pilihan. Dapat dibaca di setiap waktu mustajab.
      </p>
    </div>
  </a>

  <!-- Semua Doa — mobile only -->
  <a href="/list/semua-doa" class="block md:hidden group">
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-slate-50 to-zinc-100 border-zinc-200 dark:from-slate-900 dark:to-zinc-800 dark:border-zinc-700",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >📖</span
      >
      <h3 class="font-bold text-sm text-zinc-800 dark:text-zinc-100">
        Semua Doa
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
        Doa ma'tsuur dari Al-Qur'an dan As-Sunnah.
      </p>
    </div>
  </a>

  <!-- Kebaikan, Kesehatan dan Keberkahan — desktop only -->
  <a
    href="/list/doa-untuk-kebaikan-kesehatan-dan-keberkahan"
    class="hidden md:block group"
  >
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-sky-50 to-blue-100 border-blue-200 dark:from-sky-950 dark:to-blue-900 dark:border-blue-800",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🌤️</span
      >
      <h3 class="font-bold text-sm text-blue-900 dark:text-blue-100">
        Kebaikan & Keberkahan
      </h3>
      <p class="text-xs text-blue-700/70 dark:text-blue-300/70 leading-snug">
        Permohonan atas segala kebaikan & keberkahan di dunia.
      </p>
    </div>
  </a>

  <!-- Doa untuk Kaum Muslimin — desktop only -->
  <a href="/" class="hidden md:block group">
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-red-50 to-rose-100 border-rose-200 dark:from-red-950 dark:to-rose-900 dark:border-rose-800",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🌍</span
      >
      <h3 class="font-bold text-sm text-rose-900 dark:text-rose-100">
        Doa untuk Kaum Muslimin
      </h3>
      <p class="text-xs text-rose-700/70 dark:text-rose-300/70 leading-snug">
        Doa untuk kaum muslimin yang terzalimi di seluruh dunia.
      </p>
    </div>
  </a>

  <!-- Perlindungan dari Hal Buruk — desktop only -->
  <a
    href="/list/doa-perlindungan-dari-hal-hal-buruk"
    class="hidden md:block group"
  >
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-violet-50 to-purple-100 border-purple-200 dark:from-violet-950 dark:to-purple-900 dark:border-purple-800",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🛡️</span
      >
      <h3 class="font-bold text-sm text-purple-900 dark:text-purple-100">
        Perlindungan dari Hal Buruk
      </h3>
      <p
        class="text-xs text-purple-700/70 dark:text-purple-300/70 leading-snug"
      >
        Agar terhindar dari kesedihan, kesulitan, dan kesempitan.
      </p>
    </div>
  </a>

  <!-- Doa untuk Negeri — desktop only -->
  <a href="/list/category/kebaikan-untuk-negeri" class="hidden md:block group">
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-amber-50 to-yellow-100 border-yellow-200 dark:from-amber-950 dark:to-yellow-900 dark:border-yellow-800",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🏡</span
      >
      <h3 class="font-bold text-sm text-amber-900 dark:text-amber-100">
        Doa untuk Negeri
      </h3>
      <p class="text-xs text-amber-700/70 dark:text-amber-300/70 leading-snug">
        Kumpulan doa untuk kebaikan negeri & para pemimpinnya.
      </p>
    </div>
  </a>

  <!-- Semua Kategori — always visible -->
  <a href="/categories" class="block group">
    <div
      class={cn(
        baseCard,
        "bg-gradient-to-br from-zinc-100 to-gray-200 border-zinc-300 dark:from-zinc-800 dark:to-gray-700 dark:border-zinc-600",
      )}
    >
      <span
        class="absolute top-3 right-3 text-3xl opacity-70 group-hover:scale-110 transition-transform duration-200"
        >🗂️</span
      >
      <h3 class="font-bold text-sm text-zinc-800 dark:text-zinc-100">
        Semua Kategori
      </h3>
      <p class="text-xs text-zinc-500 dark:text-zinc-400 leading-snug">
        Lihat semua kategori dan kelompok-kelompok doa.
      </p>
    </div>
  </a>
</div>
