---
import Layout from "@/layouts/layout.astro";
import { Card } from "@/components/ui/card";

import { cn } from "@/lib/utils";
import { slugify } from "@/utils/string";

import {
  featuredCategoryCards,
  getCategoryImagePath,
  getUnsplashImageUrl,
} from "@/data/category-cards";
import TOKENIZED_CATEGORIES from "data/generated/4_tokenized-categories.json";

const sortedCategories = TOKENIZED_CATEGORIES.sort((a, b) => {
  if (a.category_id < b.category_id) {
    return -1;
  }

  if (a.category_id > b.category_id) {
    return 1;
  }

  return 0;
});

const cardClassname =
  "group relative h-[150px] overflow-hidden border-gray-100 shadow-none cursor-pointer rounded-xl border p-3 flex flex-col justify-end transition-transform duration-200 hover:-translate-y-0.5";
---

<Layout fixedNavbar>
  <section class="pt-4 md:pt-10 px-4 max-w-2xl mx-auto">
    <a href={featuredCategoryCards[0].href}>
      <Card
        className={cn(cardClassname, "border-zinc-200")}
        style={{
          backgroundImage: `linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.68)), url(${getCategoryImagePath(featuredCategoryCards[0].title, featuredCategoryCards[0].cue)})`,
          backgroundSize: "cover",
          backgroundPosition: "center",
        }}
      >
        <h3 class="font-bold text-sm md:text-base text-white drop-shadow">
          {featuredCategoryCards[0].title}
        </h3>
        <p class="font-light text-xs text-white/85 drop-shadow-sm">
          {featuredCategoryCards[0].description}
        </p>
      </Card>
    </a>
  </section>

  <section class="mt-10 px-4 max-w-2xl mx-auto">
    <h1 class="text-xl font-bold">Kategori Khusus</h1>

    <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-2">
      {
        featuredCategoryCards.slice(1).map((card) => (
          <a href={card.href}>
            <Card
              className={cn(cardClassname)}
              style={{
                backgroundImage: `linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.68)), url(${getCategoryImagePath(card.title, card.cue)})`,
                backgroundSize: "cover",
                backgroundPosition: "center",
              }}
            >
              <h3 class="font-bold text-sm md:text-base text-white drop-shadow">
                {card.title}
              </h3>
              <p class="font-light text-xs text-white/85 drop-shadow-sm line-clamp-3">
                {card.description}
              </p>
            </Card>
          </a>
        ))
      }
    </div>
  </section>

  <section class="mt-10 px-4 max-w-2xl mx-auto mb-20">
    <h1 class="text-xl font-bold">Kategori Umum</h1>

    <div class="mt-4 grid grid-cols-2 md:grid-cols-3 gap-2">
      {
        sortedCategories.map((category) => {
          const cue = `${category.category_id} islamic prayer calm`;

          return (
            <a href={`/list/category/${slugify(category.category_id)}`}>
              <Card
                className={cn(cardClassname)}
                style={{
                  backgroundImage: `linear-gradient(180deg, rgba(0,0,0,0.08), rgba(0,0,0,0.68)), url(${getUnsplashImageUrl(cue)})`,
                  backgroundSize: "cover",
                  backgroundPosition: "center",
                }}
              >
                <h3 class="text-sm font-medium line-clamp-3 text-white drop-shadow">
                  {category.category_id}
                </h3>
                <p class="font-light text-xs text-white/85 drop-shadow-sm">
                  ({category.count} doa)
                </p>
              </Card>
            </a>
          );
        })
      }
    </div>
  </section>
</Layout>
